# Impeccable transient state (screenshots, build-phase machine)
.impeccable/review/
.impeccable/build/

# Local Claude tooling stays out of the published repo, except skills that
# belong to this repository. Git cannot re-include a path under an ignored
# directory, so ignore .claude's contents rather than the directory itself.
.claude/*
!.claude/skills/
.impeccable/

# Cloudflare Worker tooling
worker/node_modules/
worker/.wrangler/
